{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@panel/*": ["../src/*"],

      "react": ["../node_modules/@types/react"],
      "react/*": ["../node_modules/@types/react/*"],
      "react-dom": ["../node_modules/@types/react-dom"],
      "react-dom/*": ["../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"]
}
