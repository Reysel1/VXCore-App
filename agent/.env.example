# Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Dirección pública del agente, de ella sale la redirect URI de Discord
# Ej.: https://panel.tudominio.com  ó  http://203.0.113.10:4000
FIVEOS_PUBLIC_URL=
FIVEOS_DOWNLOAD_URL=

# PORT=4000
# HOST=127.0.0.1

# Orígenes extra que pueden usar el agente, separados por comas
# FIVEOS_ALLOWED_ORIGINS=https://panel.tudominio.com

# Clave para servidores de juego en otra máquina (set vxcore_agent_key "..." en server.cfg)
# FIVEOS_GAME_KEY=

# Túnel propio de Cloudflare
# FIVEOS_TUNNEL_HOSTNAME=panel.tudominio.com
# FIVEOS_TUNNEL_CREDENTIALS=C:\Users\tu-usuario\.cloudflared\<id-del-tunel>.json

# FXSERVER_BIN=C:\FXServer\server\FXServer.exe
