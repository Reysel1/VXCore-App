  "private": true,
  "description": "Agente local de VXCore: controla FXServer, MySQL, Discord y automatizaciones",
  "license": "MIT",
  "author": "VXCore",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
