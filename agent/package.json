    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4",
    "systeminformation": "^5.33.16",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
